{
  "name": "packages.vue",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Vue components for acfatah/ui.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "main": "src/index.ts",
  "scripts": {
    "format": "bunx --bun eslint --fix",
    "format:changed": "{ git diff --name-only -z --diff-filter=d --relative HEAD; git ls-files -z --others --exclude-standard -- ':./'; } | xargs -0 -r bunx --bun eslint --fix --no-warn-ignored",
    "lint": "bunx --bun eslint",
    "lint:changed": "{ git diff --name-only -z --diff-filter=d --relative HEAD; git ls-files -z --others --exclude-standard -- ':./'; } | xargs -0 -r bunx --bun eslint --pass-on-no-patterns --no-warn-ignored",
    "test": "vitest --run",
    "test:components": "vitest --run --project=components",
    "test:unit": "vitest --run --project=unit",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.37.2",
    "@vueuse/core": "^14.3.0",
    "cn": "0.3.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@acfatah/eslint-preset": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/common-tags": "^1.8.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/tsconfig": "^0.9.1",
    "common-tags": "^1.8.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "playwright": "^1.61.1",
    "shadcn": "^4.13.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^3.1.0",
    "vue-tsc": "^3.3.7"
  }
}

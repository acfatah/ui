{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json"
  ],

  "compilerOptions": {
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "~shared/*": ["../../shared/*"],
      "~test/*": ["./test/*"]
    },

    "types": [
      "@types/bun"
    ]
  },

  "include": [
    "./src/**/*.ts",
    "./src/**/*.d.ts",
    "./src/**/*.vue",
    "./test/**/*.ts",
    "../../shared/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules"
  ]
}

{
  "name": "@acfatah/ui",
  "homepage": "https://github.com/acfatah/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bunx --bun eslint shared && bun run --filter './packages/*' --filter './apps/*' lint",
    "format": "bunx --bun eslint --fix shared && bun run --filter './packages/*' --filter './apps/*' format",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck",
    "docs:dev": "bun run --filter apps.docs dev",
    "docs:build": "bun run --filter apps.docs build",
    "registry:build": "bun run --filter packages.vue registry:build"
  },
  "devDependencies": {
    "@acfatah/eslint-preset": "^5.0.0",
    "@types/bun": "^1.3.14",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
